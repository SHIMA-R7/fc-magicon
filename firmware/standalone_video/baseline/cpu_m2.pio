; FC-MAGICON magicon: ファミコン CPU バスの応答(GPIO0〜31 の窓で使う)
;   GPIO0-7   CPU D0-D7(出力はここだけ)
;   GPIO8-22  CPU A0-A14
;   GPIO23    /ROMSEL(= !(A15 & M2))
;   GPIO24    R/W   ← アドレスと同時に採ったスナップショットから判定
;   GPIO25    M2
;
; bus_test(/ROMSEL で起きる)と違い、M2 で起きて CPU の全サイクルをコアへ渡す。
;   ・$6000-$7FFF(WRAM)は /ROMSEL が High のままなので、/ROMSEL だけでは拾えない
;   ・$2000-$2007 への書き込み(CHR-RAM を作るため $2006/$2007 を横から読む)も拾う
;
; 1 サイクルの流れ:
;   M2 が上がる → 40ns 待つ(/ROMSEL decoder settling)→ GPIO0〜31 を読んで push
;   → 読出しだけコアの答えを待ち、書込みは待たずにデータを捕捉する
;   → 書き込みサイクルなら、M2 が下がった所でもう一度読んで push(書き込みデータは M2 の後半で確定する)
;   → バスを放す
.program cpu_m2
.wrap_target
start:
    wait 0 gpio 25
    wait 1 gpio 25
    nop [9]                 ; 40ns @250MHz; increase read-response margin
    mov x, pins             ; one coherent address/RW snapshot
    mov isr, x
    push block              ; header to ARM (PUSH clears ISR)
    mov osr, x
    out null, 24
    out y, 1                ; R/W from the SAME snapshot
    jmp !y write
poll:
    mov x, null
    pull noblock
    mov y, osr
    jmp !y pending
    jmp pin valid
    jmp discard
pending:
    jmp pin poll
    jmp expired
valid:
    out pins, 8
    out pindirs, 8
    wait 0 gpio 25
    mov osr, null
    out pindirs, 8
.wrap
write:
    wait 0 gpio 25          ; capture data BEFORE waiting for ARM's acknowledgement
    mov isr, pins
    push block              ; second RX word: write data, no reply from ARM
    pull block              ; drain exactly the header acknowledgement, never drive
    jmp start
expired:
    pull block              ; drain late read reply while bus remains input
discard:
    irq nowait 0            ; latch any late read ACK (includes undriven internal reads)
    jmp start

% c-sdk {
static inline void cpu_m2_program_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = cpu_m2_program_get_default_config(offset);
    sm_config_set_in_pins(&c, 0);
    sm_config_set_out_pins(&c, 0, 8);
    sm_config_set_jmp_pin(&c, 25);                   // M2 deadline
    sm_config_set_in_shift(&c, false, false, 32);     // explicit header/data PUSH
    sm_config_set_out_shift(&c, true, false, 32);    // 右から取り出す、pull は手動
    for (uint i = 0; i < 8; i++)
        pio_gpio_init(pio, i);
    pio_sm_set_consecutive_pindirs(pio, sm, 0, 8, false);   // 最初は出さない
    pio_sm_init(pio, sm, offset, &c);
    // Caller enables only after core1 is ready.
}
%}
